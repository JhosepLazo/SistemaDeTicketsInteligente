# Reglas mínimas de formato para mantener consistencia entre backend, frontend y SQL.
# C# usa 4 espacios; archivos web/configuración 2 espacios; SQL usa tabulaciones de 4 posiciones.

root = true

[*]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true

[*.cs]
indent_style = space
indent_size = 4

[*.{csproj,slnx,json,ts,tsx,css,html,md}]
indent_style = space
indent_size = 2

[*.sql]
indent_style = tab
tab_width = 4
