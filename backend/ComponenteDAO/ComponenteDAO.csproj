<!--
    Archivo: ComponenteDAO.csproj
    Objetivo: Definir la biblioteca de acceso a datos del sistema.
    Responsabilidad: Configurar SQL Client y la dependencia hacia los DTO compartidos.
    Dependencias: Microsoft.Data.SqlClient y ComponenteDTO.
    Flujo: ComponenteBLL -> ComponenteDAO -> SQL Server.
    Consideraciones: La capa DAO no contiene reglas de negocio ni dependencias HTTP.
-->

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SistemaTicketsInteligente.Datos.ComponenteDAO</RootNamespace>
    <AssemblyName>SistemaTicketsInteligente.Datos.ComponenteDAO</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <ProjectReference Include="..\ComponenteDTO\ComponenteDTO.csproj" />
  </ItemGroup>
</Project>
