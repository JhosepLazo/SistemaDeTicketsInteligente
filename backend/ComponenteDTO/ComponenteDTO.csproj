<!--
    Archivo: ComponenteDTO.csproj
    Objetivo: Definir la biblioteca de contratos y modelos compartidos del sistema.
    Responsabilidad: Mantener DTO independientes de acceso a datos, HTTP y lógica de negocio.
    Dependencias: SDK de .NET.
    Flujo: SQL Server -> DAO -> DTO -> BLL -> API.
    Consideraciones: No agrega paquetes ni referencias a otras capas del sistema.
-->

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SistemaTicketsInteligente.Entidades.ComponenteDTO</RootNamespace>
    <AssemblyName>SistemaTicketsInteligente.Entidades.ComponenteDTO</AssemblyName>
  </PropertyGroup>
</Project>
