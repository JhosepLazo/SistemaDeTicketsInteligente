# Define reglas mínimas de formato para mantener consistencia en los archivos SQL.
# La indentación SQL debe realizarse con Tab y los archivos deben guardarse en UTF-8.

root = true

[*]
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.cs]
indent_style = space
indent_size = 4

[*.{csproj,sln,json,ts,tsx,css,html,md}]
indent_style = space
indent_size = 2

[*.sql]
indent_style = tab
tab_width = 4
